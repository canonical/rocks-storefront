{
  "name": "rocks-storefront",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "prepare": "svelte-kit sync && husky",
    "svelte-check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:perf",
    "svelte-check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:perf": "tsc -p perf",
    "check:tokens": "grep -rIn --include='*.svelte' --include='*.css' -- '--lp-' src/ && { echo 'Found authored --lp- token(s) in src/. Use generic Pragma tokens instead.' >&2; exit 1; } || test $? -eq 1",
    "check:styles": "grep -rIn --include='*.svelte' -e '<style' src/lib/components/ && { echo 'Found <style> block in a component. Put styles in a co-located styles.css.' >&2; exit 1; } || test $? -eq 1",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "fix": "biome check --write .",
    "test:unit": "vitest --project server --run",
    "test:component": "vitest --project client --run",
    "test:e2e": "playwright test",
    "test:perf": "k6 run perf/load.ts",
    "test:watch": "vitest",
    "test": "vitest --run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@canonical/biome-config": "0.28.0",
    "@canonical/launchpad-design-tokens": "1.1.1",
    "@canonical/styles": "0.29.0",
    "@canonical/styles-typography": "0.29.0",
    "@canonical/svelte-ds-app-launchpad": "0.27.0",
    "@canonical/svelte-icons": "0.0.9",
    "@floating-ui/dom": "1.7.6",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@playwright/test": "1.61.1",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/k6": "2.2.1",
    "@types/markdown-it": "14.1.2",
    "@types/node": "26.1.1",
    "@vitest/browser-playwright": "4.1.12",
    "husky": "9.1.7",
    "markdown-it": "14.3.1",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "playwright": "1.61.1",
    "svelte": "5.56.4",
    "svelte-check": "4.7.2",
    "typescript": "6.0.3",
    "valibot": "1.4.2",
    "vite": "8.3.5",
    "vitest": "4.1.11",
    "vitest-browser-svelte": "2.2.1"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "import-in-the-middle": "^3.5.2"
  }
}

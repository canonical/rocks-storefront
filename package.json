{
  "name": "rocks-storefront",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "prepare": "svelte-kit sync; husky",
    "svelte-check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "svelte-check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "fix": "biome check --write .",
    "test:unit": "vitest --project server --run",
    "test:component": "vitest --project client --run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test": "vitest --run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@canonical/biome-config": "^0.28.0",
    "@playwright/test": "^1.61.1",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^26.0.1",
    "@vitest/browser-playwright": "^4.1.8",
    "husky": "^9.1.7",
    "playwright": "^1.60.0",
    "sass": "^1.101.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vanilla-framework": "^4.55.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vitest-browser-svelte": "^2.1.1"
  }
}
